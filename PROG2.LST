   158                                  ; PROCEDIMIENTO 1: SUMAR_SERIE
   159                                  ; ==========================================
   160                                  
   161                                  ; Entrada: CX = N, N mayor que cero
   162                                  ; Salida: AX = suma de 1 hasta N
   163                                  ; Preserva CX utilizando la pila.
   164                                  
   165                                  sumar_serie:
   166                                  
   167 00000079 51                          push cx
   168                                  
   169                                      ; Inicializar acumulador
   170 0000007A 31C0                        xor ax, ax
   171                                  
   172                                  .paso:
   173                                  
   174                                      ; Sumar el valor del contador
   175 0000007C 01C8                        add ax, cx
   176                                  
   177                                      ; Repetir mientras CX no sea cero
   178 0000007E E2FC                        loop .paso
   179                                  
   180                                      ; Restaurar contador original
   181 00000080 59                          pop cx
   182                                  
   183 00000081 C3                          ret
