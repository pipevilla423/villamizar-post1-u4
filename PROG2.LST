   265                                  ; PROCEDIMIENTO 3:
   266                                  ; COMPARAR_MENOR_O_IGUAL
   267                                  ; ==========================================
   268                                  
   269                                  ; Entrada: AX y BX
   270                                  ; Utiliza CMP y JLE.
   271                                  ; Reutiliza macros de macros.asm.
   272                                  
   273                                  comparar_menor_o_igual:
   274                                  
   275                                      ; Preservar registros
   276 000000DA 50                          push ax
