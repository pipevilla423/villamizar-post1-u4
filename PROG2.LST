    13                              <1> 
    14                              <1> 
    15                              <1> ; ==========================================
    16                              <1> ; MACRO 1: FINALIZAR PROGRAMA DOS
    17                              <1> ; ==========================================
    18                              <1> 
    19                              <1> ; Termina el programa con codigo de salida 0.
    20                              <1> 
    21                              <1> %macro fin_dos 0
    22                              <1> 
    23                              <1>     mov ax, 4C00h
    24                              <1>     int 21h
    25                              <1> 
    26                              <1> %endmacro
    27                              <1> 
    28                              <1> 
    29                              <1> ; ==========================================
    30                              <1> ; MACRO 2: IMPRIMIR NUEVA LINEA
    31                              <1> ; ==========================================
    32                              <1> 
    33                              <1> ; Imprime retorno de carro (CR)
    34                              <1> ; y salto de linea (LF).
    35                              <1> 
    36                              <1> %macro nueva_linea 0
    37                              <1> 
    38                              <1>     mov ah, 02h
    39                              <1>     mov dl, 0Dh
    40                              <1>     int 21h
    41                              <1> 
    42                              <1>     mov ah, 02h
    43                              <1>     mov dl, 0Ah
    44                              <1>     int 21h
    45                              <1> 
    46                              <1> %endmacro
    47                              <1> 
    48                              <1> 
    49                              <1> ; ==========================================
    50                              <1> ; MACRO 3: IMPRIMIR CADENA
    51                              <1> ; ==========================================
    52                              <1> 
    53                              <1> ; %1 = etiqueta de una cadena
    54                              <1> ; terminada con el caracter '$'.
    55                              <1> 
    56                              <1> %macro print_str 1
    57                              <1> 
    58                              <1>     mov ah, 09h
    59                              <1>     mov dx, %1
    60                              <1>     int 21h
    61                              <1> 
    62                              <1> %endmacro
    63                              <1> 
    64                              <1> 
    65                              <1> ; ==========================================
    66                              <1> ; MACRO 4: IMPRIMIR CARACTER
    67                              <1> ; ==========================================
    68                              <1> 
    69                              <1> ; %1 = caracter ASCII o registro.
    70                              <1> 
    71                              <1> %macro print_char 1
    72                              <1> 
    73                              <1>     mov ah, 02h
    74                              <1>     mov dl, %1
    75                              <1>     int 21h
    76                              <1> 
    77                              <1> %endmacro
    78                              <1> 
    79                              <1> 
    80                              <1> ; ==========================================
    81                              <1> ; MACRO 5: LEER CARACTER
    82                              <1> ; ==========================================
    83                              <1> 
    84                              <1> ; Lee un caracter desde teclado sin eco.
    85                              <1> ; El resultado se almacena en AL.
    86                              <1> 
    87                              <1> %macro leer_char 0
    88                              <1> 
    89                              <1>     mov ah, 07h
    90                              <1>     int 21h
    91                              <1> 
    92                              <1> %endmacro
    93                              <1> 
    94                              <1> 
    95                              <1> ; ==========================================
    96                              <1> ; MACRO 6: REPETIR CADENA CON LOOP
    97                              <1> ; ==========================================
    98                              <1> 
    99                              <1> ; %1 = etiqueta de la cadena
   100                              <1> ; %2 = numero de repeticiones
   101                              <1> ;
   102                              <1> ; Utiliza CX como contador.
   103                              <1> ; %%ciclo es una etiqueta local unica
   104                              <1> ; para cada expansion de la macro.
   105                              <1> ;
   106                              <1> ; Requiere un numero positivo de repeticiones.
   107                              <1> 
   108                              <1> %macro repetir_str 2
   109                              <1> 
   110                              <1>     mov cx, %2
   111                              <1> 
   112                              <1> %%ciclo:
   113                              <1> 
   114                              <1>     mov ah, 09h
   115                              <1>     mov dx, %1
   116                              <1>     int 21h
   117                              <1> 
   118                              <1>     loop %%ciclo
   119                              <1> 
   120                              <1> %endmacro
   121                              <1> 
   122                              <1> 
   123                              <1> ; ==========================================
   124                              <1> ; MACRO 7: IMPRIMIR DIGITO DECIMAL
   125                              <1> ; ==========================================
   126                              <1> 
   127                              <1> ; Imprime un valor de 0 a 9
   128                              <1> ; almacenado en AL.
   129                              <1> ;
   130                              <1> ; Preserva AX mediante PUSH y POP.
   131                              <1> 
   132                              <1> %macro print_digito 0
   133                              <1> 
   134                              <1>     push ax
   135                              <1> 
   136                              <1>     ; Conservar el nibble inferior.
   137                              <1>     and al, 0Fh
   138                              <1> 
   139                              <1>     ; Convertir el digito a ASCII.
   140                              <1>     add al, 30h
   141                              <1> 
   142                              <1>     ; Imprimir el caracter.
   143                              <1>     mov ah, 02h
   144                              <1>     mov dl, al
   145                              <1>     int 21h
   146                              <1> 
   147                              <1>     ; Restaurar AX.
   148                              <1>     pop ax
   149                              <1> 
   150                              <1> %endmacro
   151                              <1> 
   152                              <1> 
   153                              <1> ; ==========================================
   154                              <1> ; MACRO 8: BLOQUE DECORATIVO CON %REP
   155                              <1> ; ==========================================
   156                              <1> 
   157                              <1> ; %1 = cantidad de repeticiones
   158                              <1> ;
   159                              <1> ; %rep duplica las instrucciones durante
   160                              <1> ; el preprocesamiento de NASM.
   161                              <1> ;
   162                              <1> ; No utiliza CX ni LOOP.
   163                              <1> ;
   164                              <1> ; Requiere que el programa principal
   165                              <1> ; defina la etiqueta separador_corto.
   166                              <1> 
   167                              <1> %macro bloque_decorativo 1
   168                              <1> 
   169                              <1>     %rep %1
   170                              <1> 
   171                              <1>         print_str separador_corto
   172                              <1> 
   173                              <1>     %endrep
   174                              <1> 
   175                              <1> %endmacro
   176                              <1> 
   177                              <1> 
   178                              <1> ; ==========================================
   179                              <1> ; FIN DE LA BIBLIOTECA DE MACROS
   180                              <1> ; ==========================================
